# ==============================================================================
# ChainGuard Environment Configuration (.env)
# LOCAL DEVELOPMENT ONLY - DO NOT USE REAL ETHEREUM / PRODUCTION KEYS HERE
# ==============================================================================

# RPC URL for local Hardhat node
RPC_URL=http://127.0.0.1:8545

# Hardhat Account #0 default dev private key (Local Testnet Only)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Hardhat Account #1 default dev private key (Publisher)
PUBLISHER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Hardhat Account #2 default dev private key (Auditor)
AUDITOR_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Backend Server Port
PORT=5000

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# Path to Deployed Contract JSON
DEPLOYED_ADDRESS_PATH=./deployed-address.json
